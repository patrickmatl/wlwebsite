# WL CreationX — environment variables
# Copy to .env.local for local dev; set the same values in Vercel for production.
# .env* is gitignored — never commit real values.
# Full walkthrough: QUOTE-SYSTEM.md

# ── Database ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://lknoyvycrbfcbvumozew.supabase.co
# Supabase → Settings → API → service_role. SECRET. Server-side only —
# it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI quote agent (Google Gemini) ──────────────────────────────────────────
# aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional — defaults to gemini-3.5-flash. Do not set gemini-3.7-flash: it
# returns 429 on this key. See the probe notes in src/lib/quote-agent.ts.
GEMINI_MODEL=

# ── Email ───────────────────────────────────────────────────────────────────
# Two transports. SMTP is what production uses; Resend is the alternative.
# If SMTP_HOST is set it wins.

# -- SMTP (cPanel mailbox) --
# cPanel → Email Accounts → Connect Devices shows these.
SMTP_HOST=c5.my-control-panel.com
SMTP_PORT=465
SMTP_USER=quotes@wlcreationx.co.za
SMTP_PASSWORD=

# -- Resend (only if you move off SMTP; needs a paid plan to add the domain) --
RESEND_API_KEY=
# Signing secret for the inbound-email webhook. Without it the webhook is
# unauthenticated — set it.
RESEND_WEBHOOK_SECRET=

QUOTE_FROM_EMAIL="WL CreationX <quotes@wlcreationx.co.za>"
# Backup alert address for new leads
OWNER_EMAIL=info@wlcreationx.co.za

# ── Reading client replies (IMAP poll) ──────────────────────────────────────
# SMTP can only send. To keep the back-and-forth conversation working, a cron
# job calls /api/inbound/poll, which reads unseen mail from the quotes@ mailbox.
# Defaults to the SMTP_* values above, so normally you only set the secret.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Long random string guarding the poll endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
INBOUND_POLL_SECRET=

# ── Autopilot ───────────────────────────────────────────────────────────────
# How much the system sends without you seeing it first.
#   off  = nothing sends itself; every draft waits in /studio (the old behaviour)
#   safe = sends everything except drafts the agent flagged low-confidence
#   all  = sends regardless of confidence
# Spam ('ignore') and anything needing a person ('handover') are NEVER auto-sent.
QUOTE_AUTOPILOT=safe
# Optional rand ceiling — quotes above this always wait for you, whatever the
# level above. Leave unset for no ceiling.
QUOTE_AUTOPILOT_MAX=
# Follow-up sequence: quiet days before each touch, counted from the last
# message either side sent. '3,7' = nudge on day 3, close-out 7 days later.
# Two touches maximum; a client reply resets the sequence.
FOLLOWUP_DAYS=3,7

# ── /studio access ──────────────────────────────────────────────────────────
# Long random string. This is the password for the approval queue.
ADMIN_TOKEN=

# ── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@wlcreationx.co.za
